@prefix : <http://www.semanticweb.org/renan/ontologia-filmes5/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/renan/ontologia-filmes5/> .

<http://www.semanticweb.org/renan/ontologia-filmes5> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/renan/ontologia-filmes5#avaliacaoFeitaPor
:avaliacaoFeitaPor rdf:type owl:ObjectProperty ;
                   owl:inverseOf :avaliou ;
                   rdfs:domain :Avaliacao ;
                   rdfs:range :Usuario .


###  http://www.semanticweb.org/renan/ontologia-filmes5#recomendacaoRecebidaPor
:recomendacaoRecebidaPor rdf:type owl:ObjectProperty ;
                         owl:inverseOf :recebeRecomendacao ;
                         rdfs:domain :Recomendacao ;
                         rdfs:range :Usuario .


###  http://www.semanticweb.org/renan/ontologia-filmes5/atuaEm
:atuaEm rdf:type owl:ObjectProperty ;
        owl:inverseOf :temAtor ;
        rdfs:domain :Ator ;
        rdfs:range :Filme .


###  http://www.semanticweb.org/renan/ontologia-filmes5/avaliaFilme
:avaliaFilme rdf:type owl:ObjectProperty ;
             rdfs:domain :Avaliacao ;
             rdfs:range :Filme .


###  http://www.semanticweb.org/renan/ontologia-filmes5/avaliou
:avaliou rdf:type owl:ObjectProperty ;
         rdfs:domain :Usuario ;
         rdfs:range :Avaliacao .


###  http://www.semanticweb.org/renan/ontologia-filmes5/dirige
:dirige rdf:type owl:ObjectProperty ;
        owl:inverseOf :temDiretor ;
        rdfs:domain :Diretor ;
        rdfs:range :Filme .


###  http://www.semanticweb.org/renan/ontologia-filmes5/ganhou
:ganhou rdf:type owl:ObjectProperty ;
        rdfs:domain :Filme ;
        rdfs:range :Premio .


###  http://www.semanticweb.org/renan/ontologia-filmes5/ocorreuEm
:ocorreuEm rdf:type owl:ObjectProperty ;
           rdfs:domain :Premio ;
           rdfs:range :Evento .


###  http://www.semanticweb.org/renan/ontologia-filmes5/pertenceAoGenero
:pertenceAoGenero rdf:type owl:ObjectProperty ;
                  rdfs:domain :Filme ;
                  rdfs:range :Genero .


###  http://www.semanticweb.org/renan/ontologia-filmes5/prefereAtor
:prefereAtor rdf:type owl:ObjectProperty ;
             rdfs:domain :Usuario ;
             rdfs:range :Ator .


###  http://www.semanticweb.org/renan/ontologia-filmes5/prefereDiretor
:prefereDiretor rdf:type owl:ObjectProperty ;
                rdfs:domain :Usuario ;
                rdfs:range :Diretor .


###  http://www.semanticweb.org/renan/ontologia-filmes5/prefereGenero
:prefereGenero rdf:type owl:ObjectProperty ;
               rdfs:domain :Usuario ;
               rdfs:range :Genero .


###  http://www.semanticweb.org/renan/ontologia-filmes5/prefereIdioma
:prefereIdioma rdf:type owl:ObjectProperty ;
               rdfs:domain :Usuario ;
               rdfs:range :Idioma .


###  http://www.semanticweb.org/renan/ontologia-filmes5/prefereNacionalidade
:prefereNacionalidade rdf:type owl:ObjectProperty ;
                      rdfs:domain :Usuario ;
                      rdfs:range :Pais .


###  http://www.semanticweb.org/renan/ontologia-filmes5/produz
:produz rdf:type owl:ObjectProperty ;
        owl:inverseOf :temProdutor ;
        rdfs:domain :Produtor ;
        rdfs:range :Filme .


###  http://www.semanticweb.org/renan/ontologia-filmes5/recebeRecomendacao
:recebeRecomendacao rdf:type owl:ObjectProperty ;
                    rdfs:domain :Usuario ;
                    rdfs:range :Recomendacao .


###  http://www.semanticweb.org/renan/ontologia-filmes5/recomendaFilme
:recomendaFilme rdf:type owl:ObjectProperty ;
                rdfs:domain :Recomendacao ;
                rdfs:range :Filme .


###  http://www.semanticweb.org/renan/ontologia-filmes5/roteiriza
:roteiriza rdf:type owl:ObjectProperty ;
           owl:inverseOf :temRoteirista ;
           rdfs:domain :Roteirista ;
           rdfs:range :Filme .


###  http://www.semanticweb.org/renan/ontologia-filmes5/similarA
:similarA rdf:type owl:ObjectProperty ,
                   owl:SymmetricProperty ;
          rdfs:domain :Usuario ;
          rdfs:range :Usuario .


###  http://www.semanticweb.org/renan/ontologia-filmes5/temAtor
:temAtor rdf:type owl:ObjectProperty ;
         rdfs:domain :Filme ;
         rdfs:range :Ator .


###  http://www.semanticweb.org/renan/ontologia-filmes5/temDiretor
:temDiretor rdf:type owl:ObjectProperty ;
            rdfs:domain :Filme ;
            rdfs:range :Diretor .


###  http://www.semanticweb.org/renan/ontologia-filmes5/temIdiomaFilme
:temIdiomaFilme rdf:type owl:ObjectProperty ;
                rdfs:domain :Filme ;
                rdfs:range :Idioma .


###  http://www.semanticweb.org/renan/ontologia-filmes5/temNacionalidadeFilme
:temNacionalidadeFilme rdf:type owl:ObjectProperty ;
                       rdfs:domain :Filme ;
                       rdfs:range :Pais .


###  http://www.semanticweb.org/renan/ontologia-filmes5/temNacionalidadePessoa
:temNacionalidadePessoa rdf:type owl:ObjectProperty ;
                        rdfs:domain :Pessoa ;
                        rdfs:range :Pais .


###  http://www.semanticweb.org/renan/ontologia-filmes5/temProdutor
:temProdutor rdf:type owl:ObjectProperty ;
             rdfs:domain :Filme ;
             rdfs:range :Produtor .


###  http://www.semanticweb.org/renan/ontologia-filmes5/temRoteirista
:temRoteirista rdf:type owl:ObjectProperty ;
               rdfs:domain :Filme ;
               rdfs:range :Roteirista .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/renan/ontologia-filmes5/anoEvento
:anoEvento rdf:type owl:DatatypeProperty ;
           rdfs:domain :Evento ;
           rdfs:range xsd:integer .


###  http://www.semanticweb.org/renan/ontologia-filmes5/anoLancamento
:anoLancamento rdf:type owl:DatatypeProperty ;
               rdfs:domain :Filme ;
               rdfs:range xsd:integer .


###  http://www.semanticweb.org/renan/ontologia-filmes5/anoProducao
:anoProducao rdf:type owl:DatatypeProperty ;
             rdfs:domain :Filme ;
             rdfs:range xsd:integer .


###  http://www.semanticweb.org/renan/ontologia-filmes5/emailUsuario
:emailUsuario rdf:type owl:DatatypeProperty ;
              rdfs:domain :Usuario ;
              rdfs:range xsd:string .


###  http://www.semanticweb.org/renan/ontologia-filmes5/idadeUsuario
:idadeUsuario rdf:type owl:DatatypeProperty ;
              rdfs:domain :Usuario ;
              rdfs:range xsd:integer .


###  http://www.semanticweb.org/renan/ontologia-filmes5/nomeEvento
:nomeEvento rdf:type owl:DatatypeProperty ;
            rdfs:domain :Evento ;
            rdfs:range xsd:string .


###  http://www.semanticweb.org/renan/ontologia-filmes5/nomePessoa
:nomePessoa rdf:type owl:DatatypeProperty ;
            rdfs:domain :Pessoa ;
            rdfs:range xsd:string .


###  http://www.semanticweb.org/renan/ontologia-filmes5/nomePremio
:nomePremio rdf:type owl:DatatypeProperty ;
            rdfs:domain :Premio ;
            rdfs:range xsd:string .


###  http://www.semanticweb.org/renan/ontologia-filmes5/nomeUsuario
:nomeUsuario rdf:type owl:DatatypeProperty ;
             rdfs:domain :Usuario ;
             rdfs:range xsd:string .


###  http://www.semanticweb.org/renan/ontologia-filmes5/notaEstrelas
:notaEstrelas rdf:type owl:DatatypeProperty ;
              rdfs:domain :Avaliacao ;
              rdfs:range xsd:integer .


###  http://www.semanticweb.org/renan/ontologia-filmes5/outroContatoUsuario
:outroContatoUsuario rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Usuario ;
                     rdfs:range xsd:string .


###  http://www.semanticweb.org/renan/ontologia-filmes5/pontuacaoRecomendacao
:pontuacaoRecomendacao rdf:type owl:DatatypeProperty ;
                       rdfs:domain :Recomendacao ;
                       rdfs:range xsd:decimal .


###  http://www.semanticweb.org/renan/ontologia-filmes5/tituloOriginal
:tituloOriginal rdf:type owl:DatatypeProperty ;
                rdfs:domain :Filme ;
                rdfs:range xsd:string .


###  http://www.semanticweb.org/renan/ontologia-filmes5/tituloPortugues
:tituloPortugues rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Filme ;
                 rdfs:range xsd:string .


###  http://www.semanticweb.org/renan/ontologia-filmes5/whatsappUsuario
:whatsappUsuario rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Usuario ;
                 rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/renan/ontologia-filmes5#FilmeDocumentario
:FilmeDocumentario rdf:type owl:Class ;
                   rdfs:subClassOf :Filme ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :pertenceAoGenero ;
                                     owl:hasValue :Documentario
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :temDiretor ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :Diretor
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :temAtor ;
                                     owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                     owl:onClass :Ator
                                   ] .


###  http://www.semanticweb.org/renan/ontologia-filmes5/Ator
:Ator rdf:type owl:Class ;
      rdfs:subClassOf :Pessoa .


###  http://www.semanticweb.org/renan/ontologia-filmes5/Avaliacao
:Avaliacao rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Restriction ;
                             owl:onProperty :avaliacaoFeitaPor ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Usuario
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :avaliaFilme ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Filme
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :notaEstrelas ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:integer
                           ] .


###  http://www.semanticweb.org/renan/ontologia-filmes5/Diretor
:Diretor rdf:type owl:Class ;
         rdfs:subClassOf :Pessoa .


###  http://www.semanticweb.org/renan/ontologia-filmes5/Evento
:Evento rdf:type owl:Class .


###  http://www.semanticweb.org/renan/ontologia-filmes5/Filme
:Filme rdf:type owl:Class ;
       rdfs:subClassOf [ rdf:type owl:Restriction ;
                         owl:onProperty :pertenceAoGenero ;
                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Genero
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :temDiretor ;
                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Diretor
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :anoProducao ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:integer
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :tituloOriginal ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:string
                       ] .


###  http://www.semanticweb.org/renan/ontologia-filmes5/Genero
:Genero rdf:type owl:Class .


###  http://www.semanticweb.org/renan/ontologia-filmes5/Idioma
:Idioma rdf:type owl:Class .


###  http://www.semanticweb.org/renan/ontologia-filmes5/Pais
:Pais rdf:type owl:Class .


###  http://www.semanticweb.org/renan/ontologia-filmes5/Pessoa
:Pessoa rdf:type owl:Class .


###  http://www.semanticweb.org/renan/ontologia-filmes5/Premio
:Premio rdf:type owl:Class .


###  http://www.semanticweb.org/renan/ontologia-filmes5/Produtor
:Produtor rdf:type owl:Class ;
          rdfs:subClassOf :Pessoa .


###  http://www.semanticweb.org/renan/ontologia-filmes5/Recomendacao
:Recomendacao rdf:type owl:Class ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty :recomendacaoRecebidaPor ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :Usuario
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :recomendaFilme ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :Filme
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :pontuacaoRecomendacao ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:decimal
                              ] .


###  http://www.semanticweb.org/renan/ontologia-filmes5/Roteirista
:Roteirista rdf:type owl:Class ;
            rdfs:subClassOf :Pessoa .


###  http://www.semanticweb.org/renan/ontologia-filmes5/Usuario
:Usuario rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty :idadeUsuario ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:integer
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :nomeUsuario ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:string
                         ] .


